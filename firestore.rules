rules_version = '2';
// Firebase Console > Firestore Database > Rules > paste > Publish.
// The admin is identified by the verified sign-in token, never by anything the page sends.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Admin = the store account with a VERIFIED email (e.g. signed in with Google),
    // OR the exact admin user id. If the admin dashboard is empty, copy the admin UID shown on the
    // admin page (or Firebase Console > Authentication > Users > User UID) and put it below.
    function isAdmin() {
      return signedIn() && (
        request.auth.uid == "PUT_ADMIN_UID_HERE"
        || (request.auth.token.email == "youyouscookies@gmail.com" && request.auth.token.email_verified == true)
      );
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Orders can be placed by guests OR signed-in customers, with strict shape/size checks.
    function validOrder() {
      let d = request.resource.data;
      return d.keys().hasOnly(['userId','userEmail','customerName','phone','address','items',
                               'subtotalAmount','originalPrice','discountAmount','promoCode',
                               'totalAmount','status','date','createdAt'])
        && d.keys().hasAll(['userId','customerName','phone','address','items','totalAmount','status','createdAt'])
        && ((request.auth == null && d.userId == 'guest') || (signedIn() && d.userId == request.auth.uid))
        && d.status == 'Processing'
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && d.totalAmount is number && d.totalAmount >= 0 && d.totalAmount <= 3000
        && d.customerName is string && d.customerName.size() <= 80
        && d.phone is string && d.phone.size() <= 30
        && d.address is string && d.address.size() <= 400
        && d.createdAt == request.time;
    }

    match /orders/{orderId} {
      allow create: if validOrder();
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if
        // admin may only change the status
        (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['Processing', 'Delivered', 'Cancelled'])
        // a customer may only cancel their OWN order while it is still Processing
        || (signedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.status == 'Processing'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'Cancelled');
      allow delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // new accounts can only ever be "customer", with their own email
      allow create: if isOwner(uid)
        && request.resource.data.role == 'customer'
        && request.resource.data.email.lower() == request.auth.token.email.lower();
      // users can edit their own profile/cart but never their role
      allow update: if (isOwner(uid) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // Reviews: anyone can read approved ones; signed-in users can submit a pending one;
    // only the admin can approve / reject / delete.
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name','rating','text','status','userId','createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 25
        && request.resource.data.text is string && request.resource.data.text.size() >= 3 && request.resource.data.text.size() <= 200
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    // Promo codes: signed-in customers can read them (needed to validate a code) and may only
    // add THEIR OWN uid to usedBy. The admin has full control.
    match /promo_codes/{promoId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
          && request.resource.data.usedBy.size() == resource.data.usedBy.size() + 1
          && request.auth.uid in request.resource.data.usedBy
          && !(request.auth.uid in resource.data.usedBy));
    }

    // One document per (promo code, account): its id is <promoId>_<uid>, so the same account can never
    // create it twice. It is written in the SAME batch as the order, and must point to a real order of that user.
    match /promo_uses/{useId} {
      allow read: if isAdmin() || (signedIn() && useId.matches('.+_' + request.auth.uid));
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['promoId','code','uid','userEmail','userName','orderId','discountAmount','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && useId == request.resource.data.promoId + '_' + request.auth.uid
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.promoCode == request.resource.data.code;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
