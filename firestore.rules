rules_version = '2';
// Firebase Console > Firestore Database > Rules > paste > Publish.
// The admin is identified by the verified sign-in token, never by anything the page sends.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Admin = the store account with a VERIFIED email (e.g. signed in with Google),
    // OR the exact admin user id. If the admin dashboard is empty, copy the admin UID shown on the
    // admin page (or Firebase Console > Authentication > Users > User UID) and put it below.
    function isAdmin() {
      return signedIn() && (
        request.auth.uid == "PUT_ADMIN_UID_HERE"
        || (request.auth.token.email == "youyouscookies@gmail.com" && request.auth.token.email_verified == true)
      );
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // ---------------- MENU LOCK ----------------
    // The menu lives in /menu_items (only the admin can change it). When the admin turns the lock ON
    // (document /settings/menu_lock, created by the admin dashboard > Menu tab), every order line must be
    // a real, available menu item sold at EXACTLY the price stored in the database, and subtotalAmount
    // must equal the sum of the lines. Max 5 different items per order (Firestore allows 10 document
    // reads per rule check: 3 for the blacklist + 1 for the lock + up to 5 menu items = 9).
    // Emergency off switch: delete /settings/menu_lock in the Firebase console (or press Unlock in the dashboard).
    function menuLockOn() { return exists(/databases/$(database)/documents/settings/menu_lock); }
    function menuLineOk(items, i) {
      return items.size() <= i || (
        items[i].keys().hasOnly(['id', 'name', 'price', 'quantity'])
        && items[i].id is string && items[i].id.size() > 0 && items[i].id.size() <= 80
        && items[i].quantity is int && items[i].quantity >= 1 && items[i].quantity <= 99
        && items[i].price is number
        && menuMatches(items[i])
      );
    }
    function menuMatches(it) {
      let m = get(/databases/$(database)/documents/menu_items/$(it.id)).data;
      return m.available == true && m.price == it.price;
    }
    function menuLine(items, i) { return items.size() <= i ? 0 : items[i].price * items[i].quantity; }
    function menuSubtotal(items) {
      return menuLine(items, 0) + menuLine(items, 1) + menuLine(items, 2) + menuLine(items, 3) + menuLine(items, 4);
    }
    function menuOk(d) {
      return !menuLockOn() || (
        d.items.size() <= 5
        && menuLineOk(d.items, 0) && menuLineOk(d.items, 1) && menuLineOk(d.items, 2)
        && menuLineOk(d.items, 3) && menuLineOk(d.items, 4)
        && ('subtotalAmount' in d) && d.subtotalAmount == menuSubtotal(d.items)
        // without a promo code nobody can pay less than the items + delivery (free from 100 DH)
        && ((('promoCode' in d) && d.promoCode is string && d.promoCode.size() > 0 && signedIn()
             && d.discountAmount is number && d.discountAmount >= 0 && d.discountAmount <= d.subtotalAmount)
            || d.totalAmount >= d.subtotalAmount + (d.subtotalAmount >= 100 ? 0 : 15))
      );
    }

    // Orders can be placed by guests OR signed-in customers, with strict shape/size checks.
    function validOrder() {
      let d = request.resource.data;
      return d.keys().hasOnly(['userId','userEmail','customerName','phone','address','items',
                               'subtotalAmount','originalPrice','discountAmount','promoCode',
                               'totalAmount','status','date','createdAt','trackingCode','phoneKey'])
        && d.keys().hasAll(['userId','customerName','phone','address','items','totalAmount','status','createdAt','phoneKey'])
        && ((request.auth == null && d.userId == 'guest') || (signedIn() && d.userId == request.auth.uid))
        && d.status == 'Processing'
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && menuOk(d)
        && d.totalAmount is number && d.totalAmount >= 0 && d.totalAmount <= 3000
        && (!('userEmail' in d) || (d.userEmail is string && d.userEmail.size() <= 200))
        && (!signedIn() || !('userEmail' in d) || !('email' in request.auth.token) || d.userEmail.lower() == request.auth.token.email.lower())
        && d.customerName is string && d.customerName.size() <= 80
        && d.phone is string && d.phone.size() <= 30
        && d.address is string && d.address.size() <= 400
        && (!('trackingCode' in d) || (d.trackingCode is string && d.trackingCode.matches('[A-Z0-9]{8}')))
        // ---- BLACKLIST: refuse the order if this phone / account / email is on the admin's blacklist ----
        // phoneKey must be the LAST 9 DIGITS of the phone (so +212 6.. and 06.. are the same person)
        && d.phoneKey is string && d.phoneKey.matches('[0-9]{9}')
        && d.phone.replace('[^0-9]', '').matches('.*' + d.phoneKey)
        && !exists(/databases/$(database)/documents/blacklist/$('p_' + d.phoneKey))
        && !(signedIn() && exists(/databases/$(database)/documents/blacklist/$('u_' + request.auth.uid)))
        && !(signedIn() && ('email' in request.auth.token)
             && exists(/databases/$(database)/documents/blacklist/$('e_' + request.auth.token.email.lower())))
        && d.createdAt == request.time;
    }

    match /orders/{orderId} {
      allow create: if validOrder();
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if
        // admin may only change the status
        (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['Processing', 'Delivered', 'Returned', 'Cancelled'])
        // a customer may only cancel their OWN order while it is still Processing
        || (signedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.status == 'Processing'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'Cancelled');
      allow delete: if isAdmin();
    }

    // Public order tracking: ONE small document per order, id = the 8-letter tracking code on the receipt.
    // Anyone who knows the code can READ that single document (status only - no name, phone or address).
    // Nobody can list/search them (so codes cannot be guessed by browsing). It is created in the same batch as the
    // order, and only the admin (or the customer cancelling their own order) can change its status.
    match /order_tracking/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if code.matches('[A-Z0-9]{8}')
        && request.resource.data.keys().hasOnly(['orderId','status','itemCount','createdAt','updatedAt'])
        && request.resource.data.status == 'Processing'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.trackingCode == code;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (
          (isAdmin() && request.resource.data.status in ['Processing','Delivered','Returned','Cancelled'])
          || (signedIn()
              && request.resource.data.status == 'Cancelled'
              && resource.data.status == 'Processing'
              && get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.userId == request.auth.uid)
        );
      allow delete: if isAdmin();
    }

    // Newsletter "unsubscribed" markers. The document id IS the user's secret unsubscribe token (from the link in every
    // email), so only someone holding the token can read / create / delete that one marker. Nobody can list them
    // except the admin. Re-subscribing = deleting the marker.
    match /unsubscribes/{token} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if token.size() >= 20 && token.size() <= 64 && token.matches('[A-Za-z0-9]+')
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at is timestamp;
      allow update: if false;
      allow delete: if true;
    }

    // Sent newsletters history (admin only)
    // Blacklist (admin only). Document ids: p_<last 9 digits of phone>, e_<email in lowercase>, u_<account uid>.
    // The order rule above only checks that these documents EXIST - customers can never read the list.
    match /blacklist/{key} {
      allow read, write: if isAdmin();
    }

    // ---------------- MENU (public read, admin-only write) ----------------
    match /menu_items/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin() && validMenuItem(request.resource.data) && itemId.matches('[A-Za-z0-9_-]{1,80}');
      allow delete: if isAdmin();
    }
    function validMenuItem(d) {
      return d.keys().hasOnly(['name','price','category','desc','image','badge','badgeStyle','available','sortOrder','updatedAt','nameFr','nameAr','descFr','descAr'])
        && d.keys().hasAll(['name','price','category','available'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && d.price is number && d.price > 0 && d.price <= 1000
        && d.category in ['cookies', 'boxes']
        && d.available is bool
        && (!('desc' in d) || (d.desc is string && d.desc.size() <= 300))
        && (!('badge' in d) || (d.badge is string && d.badge.size() <= 30))
        && (!('nameFr' in d) || (d.nameFr is string && d.nameFr.size() <= 60))
        && (!('nameAr' in d) || (d.nameAr is string && d.nameAr.size() <= 60))
        && (!('descFr' in d) || (d.descFr is string && d.descFr.size() <= 300))
        && (!('descAr' in d) || (d.descAr is string && d.descAr.size() <= 300))
        && (!('badgeStyle' in d) || d.badgeStyle in ['', 'box-badge'])
        && (!('sortOrder' in d) || d.sortOrder is number)
        && (!('image' in d) || (d.image is string && d.image.size() <= 200000
              && (d.image.matches('assets/images/[A-Za-z0-9._-]+')
                  || d.image.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+'))));
    }

    // Privacy Policy text (public read, admin-only write; edited in the dashboard > Privacy Policy tab)
    match /site_content/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && id == 'privacy'
        && request.resource.data.keys().hasOnly(['en', 'fr', 'ar', 'version', 'updatedAt'])
        && request.resource.data.keys().hasAll(['en', 'version', 'updatedAt'])
        && request.resource.data.en is string && request.resource.data.en.size() > 0 && request.resource.data.en.size() <= 30000
        && (!('fr' in request.resource.data) || (request.resource.data.fr is string && request.resource.data.fr.size() <= 30000))
        && (!('ar' in request.resource.data) || (request.resource.data.ar is string && request.resource.data.ar.size() <= 30000))
        && request.resource.data.version is string && request.resource.data.version.size() <= 40;
      allow delete: if false;
    }

    // Admin settings (menu lock switch)
    match /settings/{id} {
      allow read, write: if isAdmin();
    }

    match /campaigns/{id} {
      allow read, write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // new accounts can only ever be "customer", with their own email
      allow create: if isOwner(uid)
        && request.resource.data.role == 'customer'
        && request.resource.data.email.lower() == request.auth.token.email.lower();
      // users can edit their own profile/cart but never their role
      allow update: if (isOwner(uid) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // Reviews: anyone can read approved ones; signed-in users can submit a pending one;
    // only the admin can approve / reject / delete.
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name','rating','text','status','userId','createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 25
        && request.resource.data.text is string && request.resource.data.text.size() >= 3 && request.resource.data.text.size() <= 200
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    // Promo codes: signed-in customers can read them (needed to validate a code) and may only
    // add THEIR OWN uid to usedBy. The admin has full control.
    match /promo_codes/{promoId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
          && request.resource.data.usedBy.size() == resource.data.usedBy.size() + 1
          && request.auth.uid in request.resource.data.usedBy
          && !(request.auth.uid in resource.data.usedBy));
    }

    // One document per (promo code, account): its id is <promoId>_<uid>, so the same account can never
    // create it twice. It is written in the SAME batch as the order, and must point to a real order of that user.
    match /promo_uses/{useId} {
      allow read: if isAdmin() || (signedIn() && useId.matches('.+_' + request.auth.uid));
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['promoId','code','uid','userEmail','userName','orderId','discountAmount','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && useId == request.resource.data.promoId + '_' + request.auth.uid
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.promoCode == request.resource.data.code;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
